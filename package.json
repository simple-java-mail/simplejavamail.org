{
  "name": "simple-java-mail",
  "version": "2.0.0",
  "description": "Simple Java Mail documentation and project website",
  "private": true,
  "scripts": {
    "start": "npm run dev",
    "build": "gulp --gulpfile gulpfile.mjs build",
    "dev": "gulp --gulpfile gulpfile.mjs dev",
    "clean": "gulp --gulpfile gulpfile.mjs clean",
    "check": "tsc -p tsconfig.json --noEmit && gulp --gulpfile gulpfile.mjs check",
    "verifyLinks": "node scripts/verify-links.js all",
    "verifyLinks:internal": "node scripts/verify-links.js internal",
    "verifyLinks:external": "node scripts/verify-links.js external"
  },
  "contributors": [
    "Benny Bottema <benny@bennybottema.com>"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "gulp": "^5.0.1",
    "gulp-autoprefixer": "^10.0.0",
    "gulp-less": "^5.0.0",
    "handlebars": "^4.7.9",
    "marked": "^18.0.11",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "keywords": [
    "email",
    "smtp",
    "jakarta mail",
    "smtp",
    "dkim",
    "smime",
    "openpgp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bbottema/simple-java-mail.git"
  },
  "bugs": {
    "url": "https://github.com/bbottema/simple-java-mail/issues"
  },
  "homepage": "https://github.com/bbottema/simple-java-mail"
}
