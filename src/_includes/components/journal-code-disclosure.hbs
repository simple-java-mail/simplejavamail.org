<details class="journal-code-disclosure" data-pagefind-ignore>
<summary>
<span class="journal-code-preview" aria-hidden="true">{{#each previewLines}}<span class="journal-code-preview-line">{{this}}</span>{{/each}}</span>
<span class="journal-code-action"><span class="journal-code-expand">Expand {{title}} <span aria-hidden="true">↓</span></span><span class="journal-code-collapse">Collapse {{title}} <span aria-hidden="true">↑</span></span></span>
</summary>

<pre><code class="language-{{language}}">{{source}}</code></pre>

</details>
