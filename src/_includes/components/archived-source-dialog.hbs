<dialog class="archive-dialog" data-archive-dialog aria-labelledby="archive-dialog-label">
  <div class="archive-dialog-frame">
    <header class="archive-dialog-toolbar">
      <div>
        <strong id="archive-dialog-label" data-archive-dialog-label>Recovered source</strong>
        <span data-archive-dialog-title></span>
      </div>
      <nav aria-label="Archive viewer controls">
        <a href="/" target="_blank" rel="noopener" data-archive-dialog-open>Open full page</a>
        <button type="button" autofocus data-archive-dialog-close>Close</button>
      </nav>
    </header>
    <div class="archive-dialog-viewport" data-archive-dialog-viewport aria-busy="false">
      <p class="archive-dialog-status" role="status" data-archive-dialog-status>Recovering the archived page…</p>
      <div data-archive-dialog-content></div>
    </div>
  </div>
</dialog>
