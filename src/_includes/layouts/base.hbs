<!doctype html>
<html lang="en" class="language-java">
  <head>
    {{> head}}
  </head>
  <body class="docs-page">
    <a class="skip-link" href="#main-content">Skip to content</a>
    {{> site-header}}
    <div id="navigation" class="compatibility-anchor" aria-hidden="true"></div>

    <div class="docs-shell">
      {{> docs-sidebar}}

      <main id="main-content" class="docs-content" data-pagefind-body>
        {{#with migrationNotice}}
          <aside class="migration-notice" aria-label="Migration automation">
            {{message}} <a href="{{href}}">{{linkText}}</a>.
          </aside>
        {{/with}}
        {{#if customDocsContent}}
          {{{content}}}
        {{else}}
        {{> breadcrumbs}}
        <header class="doc-hero">
          {{#with (guideContext page.url nav @root.capabilities)}}
            <p class="eyebrow"><a href="{{href}}">{{label}}</a></p>
          {{else}}
            {{#if section}}<p class="eyebrow">{{section}}</p>{{/if}}
          {{/with}}
          <h1>{{title}}</h1>
          <p class="doc-lede">{{description}}</p>
          {{#if showOpenSourceBadges}}
            <div class="doc-hero-support">
              <div class="start-fact-row doc-hero-facts" aria-label="Project details">
                <span>Open source</span>
                <span>{{site.license}}</span>
              </div>
              <a class="button button-secondary" href="/feature-matrix.html">Compare to other libraries <span aria-hidden="true">→</span></a>
            </div>
          {{/if}}
        </header>

        <article class="legacy-doc-content" data-pagefind-weight="2">
          {{{content}}}
        </article>
        {{/if}}

        <nav class="doc-next" aria-label="Documentation next steps">
          {{#with (guideContext page.url nav @root.capabilities)}}
            <a href="{{href}}"><span>More in this group</span><strong>{{label}} <span aria-hidden="true">→</span></strong></a>
          {{else}}
            <a href="/docs.html"><span>Find another task</span><strong>Documentation index <span aria-hidden="true">→</span></strong></a>
          {{/with}}
          <a href="/contact.html">
            <span>Something unclear?</span>
            <strong>Help and contribute <span aria-hidden="true">→</span></strong>
          </a>
        </nav>
      </main>
    </div>

    {{> footer}}
    <script src="/assets/lib/prism.js"></script>
    <script>window.Prism && window.Prism.highlightAll();</script>
    <script src="/pages/scripts/lazy-img-loader.js"></script>
    <script type="module" src="/scripts/site.js"></script>
    <script type="module" src="/pagefind/pagefind-component-ui.js"></script>
    {{#if mermaid}}
      <script src="/assets/lib/mermaid.min.js"></script>
      <script type="module" src="/scripts/mermaid.js"></script>
    {{/if}}
    {{#if mimeStructureDemo}}{{> components/mimemessage--structure-demo-script}}{{/if}}
  </body>
</html>
