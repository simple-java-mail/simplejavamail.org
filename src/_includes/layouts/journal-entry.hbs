<!doctype html>
<html lang="en" class="language-java">
  <head>
    {{> head}}
  </head>
  <body class="marketing-page journal-article-page">
    <a class="skip-link" href="#journal-article">Skip to article</a>
    {{> site-header}}

    <main id="main-content" data-pagefind-body>
      <header class="journal-article-hero">
        <div class="shell journal-article-hero-inner">
          <a class="journal-back-link" href="{{site.journal.indexUrl}}"><span aria-hidden="true">←</span> Engineering Journal</a>
          {{#if series}}
            <p class="journal-series-label">
              <span>{{series.title}}</span>
              <span aria-hidden="true">·</span>
              <span class="journal-series-part">Part {{series.part}} of {{series.total}}</span>
            </p>
          {{else}}
            <p class="eyebrow">{{category}}</p>
          {{/if}}
          <h1>{{title}}</h1>
          <p class="journal-article-lede">{{description}}</p>
          <p class="journal-byline">By <strong>{{author}}</strong></p>
        </div>
      </header>

      <div class="shell journal-article-grid">
        <aside class="journal-record-rail" aria-label="Article record" data-pagefind-ignore>
          <dl>
            <div>
              <dt>Published</dt>
              <dd><time datetime="{{publishedIso}}">{{publishedLabel}}</time></dd>
            </div>
            {{#if updatedIso}}
              <div>
                <dt>Last revisited</dt>
                <dd><time datetime="{{updatedIso}}">{{updatedLabel}}</time></dd>
              </div>
            {{/if}}
          </dl>

          {{#if (journalHeadings content)}}
            <nav class="journal-entry-toc" aria-label="In this entry">
              <span>In this entry</span>
              <ol>
                {{#each (journalHeadings content)}}
                  <li class="journal-toc-depth-{{depth}}"><a href="#{{id}}">{{text}}</a></li>
                {{/each}}
              </ol>
            </nav>
          {{/if}}
        </aside>

        <article id="journal-article" class="journal-prose">
          {{> components/journal-entry-navigation
            className="journal-entry-navigation journal-entry-navigation--top"
            label="Article navigation before entry"
          }}
          <aside
            class="journal-writing-note {{#if ai-banner}}journal-writing-note--ai{{else}}journal-writing-note--without-ai{{/if}}"
            aria-label="Article authorship disclosure"
            data-pagefind-ignore
          >
            <strong class="journal-writing-note-label">
              {{#if ai-banner}}AI-assisted{{else}}Written without AI{{/if}}
            </strong>
            <p>
              {{#if ai-banner}}
                {{ai-banner}}
              {{else}}
                No AI was used to write this article (except for fixing typos).
              {{/if}}
            </p>
          </aside>
          {{{content}}}
        </article>
      </div>

      {{> components/journal-entry-navigation
        className="shell journal-entry-navigation journal-entry-navigation--bottom"
        label="Article navigation after entry"
      }}
    </main>

    {{> components/archived-source-dialog}}
    {{> footer}}
    <script src="/assets/lib/prism.js"></script>
    <script>window.Prism && window.Prism.highlightAll();</script>
    {{#if mermaid}}
      <script src="/assets/lib/mermaid.min.js"></script>
      <script type="module" src="/scripts/mermaid.js"></script>
    {{/if}}
    <script type="module" src="/scripts/site.js"></script>
  </body>
</html>
