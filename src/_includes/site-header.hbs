<header class="site-header" data-site-header>
  <div class="site-header-inner">
    <a class="brand" href="/" aria-label="Simple Java Mail home">
      <img class="brand-logo" src="/assets/sjm-logo.png" width="936" height="183" alt="">
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation header-actions">
      <span data-nav-toggle-label>Menu</span>
      <span class="nav-toggle-lines" aria-hidden="true"></span>
    </button>

    <nav id="primary-navigation" class="primary-nav" aria-label="Primary">
      <ul>
        {{#each nav.primary}}
          <li class="{{#if submenu}}nav-has-submenu{{/if}}">
            <a href="{{href}}" class="{{activeClass href @root.page.url}}"{{#if submenu}} aria-haspopup="true"{{/if}}>
              {{label}}{{#if submenu}}<span class="nav-submenu-caret" aria-hidden="true"></span>{{/if}}
            </a>
            {{#if submenu}}
              <button class="nav-submenu-toggle" type="button" aria-expanded="false" aria-controls="primary-{{submenu.id}}-submenu" data-submenu-label="{{submenu.toggleLabel}}">
                <span class="visually-hidden">Show {{submenu.toggleLabel}}</span>
                <span class="nav-submenu-caret" aria-hidden="true"></span>
              </button>
              <ul id="primary-{{submenu.id}}-submenu" class="primary-submenu" aria-label="{{submenu.label}}">
                {{#if submenu.items}}
                  {{#each submenu.items}}
                    <li><a href="{{href}}">{{label}}</a></li>
                  {{/each}}
                {{else}}
                  {{#each @root.nav.docsGroups}}
                    {{#unless (eq label "Maintain")}}
                      {{#each items}}
                        {{#if @first}}
                          <li><a href="{{this.url}}" class="{{activeClass this.url @root.page.url}}">{{../label}}</a></li>
                        {{/if}}
                      {{/each}}
                    {{/unless}}
                  {{/each}}
                {{/if}}
                {{#each submenu.trailingItems}}
                  <li><a href="{{href}}" class="{{activeClass href @root.page.url}}">{{label}}</a></li>
                  {{#if (eq href "/use-cases.html")}}
                    {{> components/field-guide-menu-items collections=@root.collections}}
                  {{/if}}
                {{/each}}
              </ul>
            {{/if}}
          </li>
        {{/each}}
      </ul>
    </nav>

    <div id="header-actions" class="header-actions">
      <button class="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false" hidden {{#if (eq theme "cyberpunk")}}disabled title="This article uses its own cyberpunk theme"{{else}}title="Switch to dark mode"{{/if}}>
        <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 15.6A8.5 8.5 0 0 1 8.4 4 8.5 8.5 0 1 0 20 15.6Z"/></svg>
        <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4 19 5"/></svg>
      </button>
      <a class="header-utility" href="{{nav.utility.href}}">{{nav.utility.label}}</a>
      <a class="header-cta {{activeClass nav.cta.href page.url}}" href="{{nav.cta.href}}">{{nav.cta.label}}<span class="cta-arrow" aria-hidden="true">→</span></a>
    </div>
  </div>
</header>
