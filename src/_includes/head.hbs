<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
{{#if (eq page.url "/")}}
  <title>Simple Java Mail: Build, secure, and send email from Java</title>
{{else}}
  <title>{{title}} | Simple Java Mail</title>
{{/if}}
<meta name="description" content="{{description}}">
<link rel="canonical" href="{{site.url}}{{page.url}}">
<meta property="og:site_name" content="Simple Java Mail">
<meta property="og:type" content="{{#if ogType}}{{ogType}}{{else}}website{{/if}}">
<meta property="og:title" content="{{#if (eq page.url "/")}}Simple Java Mail: Build, secure, and send email from Java{{else}}{{title}} | Simple Java Mail{{/if}}">
<meta property="og:description" content="{{description}}">
<meta property="og:url" content="{{site.url}}{{page.url}}">
{{#if author}}<meta name="author" content="{{author}}">{{/if}}
{{#if publishedIso}}<meta property="article:published_time" content="{{publishedIso}}">{{/if}}
{{#if updatedIso}}<meta property="article:modified_time" content="{{updatedIso}}">{{/if}}
{{#if draft}}<meta name="robots" content="noindex, nofollow">{{/if}}
<meta name="twitter:card" content="summary">
<link rel="alternate" type="application/rss+xml" title="{{site.journal.title}} | {{site.name}}" href="{{site.journal.feedUrl}}">
<link rel="icon" href="/assets/sjm-favicon.png" type="image/png">
<link rel="icon" href="/assets/sjm-favicon-dark.png" type="image/png" sizes="256x256" media="(prefers-color-scheme: dark)">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/main.css">
{{#if style}}<link rel="stylesheet" href="/assets/{{style}}.css">{{/if}}
<link rel="stylesheet" href="/pagefind/pagefind-component-ui.css">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  "name": "Simple Java Mail",
  "description": "An open-source Java library for composing, securing, and delivering email, including DKIM, S/MIME, OpenPGP/MIME, batching, connection pooling, and SMTP clusters",
  "codeRepository": "{{site.repository}}",
  "programmingLanguage": "Java",
  "license": "https://www.apache.org/licenses/LICENSE-2.0",
  "version": "{{site.version}}"
}
</script>
{{#if schema}}<script type="application/ld+json">{{{json schema}}}</script>{{/if}}
{{#if (eq page.url site.journal.indexUrl)}}<script type="application/ld+json">{{{json (journalCollectionSchema site collections.journal)}}}</script>{{/if}}
