{{#*inline "docsNavLink"}}
<a href="{{this.url}}"{{#with (docsCurrent this.url @root.page.url @root.breadcrumbParent @root.nav.docsGroups)}} aria-current="{{this}}"{{/with}}>{{title}}</a>
{{/inline}}
<aside class="docs-sidebar" data-docs-sidebar data-pagefind-ignore>
  <button class="sidebar-toggle" type="button" aria-expanded="false" aria-controls="docs-navigation-body">
    <span>Documentation navigation</span>
    <span aria-hidden="true">⌄</span>
  </button>
  <div id="docs-navigation-body" class="docs-navigation-body">
    <div class="docs-search">
      <pagefind-searchbox placeholder="Search docs" show-sub-results></pagefind-searchbox>
    </div>
    <nav class="docs-nav" aria-label="Documentation">
      {{#each (documentationGroups nav @root.capabilities)}}
        <section class="docs-nav-group">
          <h2>{{label}}</h2>
          <ul>
            {{#each items}}
              <li>
                {{#if this.url}}
                  {{> docsNavLink}}
                {{else}}
                  <span class="docs-nav-label">{{title}}</span>
                {{/if}}
                {{#if children}}
                  <ul class="docs-nav-children">
                    {{#each children}}
                      <li>
                        {{> docsNavLink}}
                      </li>
                    {{/each}}
                  </ul>
                {{/if}}
              </li>
            {{/each}}
          </ul>
        </section>
      {{/each}}
    </nav>
  </div>
</aside>
