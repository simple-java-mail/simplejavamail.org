<!doctype html>
<html lang="en" class="language-java">
  <head>
    {{> head}}
  </head>
  <body class="docs-page">
    <a class="skip-link" href="#main-content">Skip to content</a>
    {{> site-header}}
    <div id="navigation" class="compatibility-anchor" aria-hidden="true"></div>

    <div class="docs-shell">
      {{> docs-sidebar}}

      <main id="main-content" class="docs-content" data-pagefind-body>
        {{> breadcrumbs}}
        <header class="doc-hero">
          {{#if page.section}}<p class="eyebrow">{{page.section}}</p>{{/if}}
          <h1>{{page.title}}</h1>
          <p class="doc-lede">{{page.description}}</p>
        </header>

        <article class="legacy-doc-content">
          {{#> body-block}}{{/body-block}}
        </article>

        <nav class="doc-next" aria-label="Documentation next steps">
          <a href="/docs.html">
            <span>Find another task</span>
            <strong>Documentation index <span aria-hidden="true">→</span></strong>
          </a>
          <a href="/contact.html">
            <span>Something unclear?</span>
            <strong>Help and contribute <span aria-hidden="true">→</span></strong>
          </a>
        </nav>
      </main>
    </div>

    {{> footer}}
    <script src="/assets/lib/prism.js"></script>
    <script>window.Prism && window.Prism.highlightAll();</script>
    <script src="/pages/scripts/lazy-img-loader.js"></script>
    <script type="module" src="/scripts/site.js"></script>
    <script type="module" src="/pagefind/pagefind-component-ui.js"></script>
    {{#> scripts-block}}{{/scripts-block}}
  </body>
</html>
