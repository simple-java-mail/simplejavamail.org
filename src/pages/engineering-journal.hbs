---
layout: "layouts/marketing.hbs"
permalink: "/engineering-journal.html"
tags:
  - "publicPage"
title: "Engineering Journal"
style: "journal"
description: "Whole-system email design, project archaeology, and maintainer perspectives from the development of Simple Java Mail."
---
    <section class="journal-index">
      <div class="shell journal-index-inner">
        <header class="journal-index-header">
          <h1>Engineering Journal</h1>
          <a class="journal-feed-link" href="{{site.journal.feedUrl}}">RSS</a>
        </header>

        <div class="journal-entry-list">
          {{#each (journalOldestFirst collections.journal)}}
            <article class="journal-entry-row">
              <div class="journal-entry-row-copy">
                {{#if data.series}}
                  <p class="journal-series-label journal-series-label--index">
                    <span>{{data.series.title}}</span>
                    <span aria-hidden="true">·</span>
                    <span class="journal-series-part">Part {{data.series.part}} of {{data.series.total}}</span>
                  </p>
                {{/if}}
                <h2><a href="{{this.url}}">{{data.title}}</a></h2>
                <p>{{data.description}}</p>
                <p class="journal-entry-row-meta">
                  <time datetime="{{isoDate date}}">{{formatDate date}}</time>
                  <span aria-hidden="true">·</span>
                  <span>{{data.category}}</span>
                </p>
              </div>
            </article>
          {{/each}}
        </div>
      </div>
    </section>
