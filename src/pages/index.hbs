    <section class="hero home-hero">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <h1>Simple to use.<br><em>Built for the real world.</em></h1>
          <p class="hero-lede">Send a well-formed email with a small fluent API. If you later need DKIM, S/MIME, proxies, batch sending, or multiple SMTP clusters, you keep using the same builders and mailer.</p>
          <div class="button-row">
            <a class="button button-primary" href="/download.html">Send your first email <span aria-hidden="true">→</span></a>
            <a class="text-link" href="#delivery-route">See what it handles <span aria-hidden="true">↓</span></a>
          </div>
        </div>

        <div class="code-window hero-code" aria-label="Minimal Simple Java Mail example">
          <div class="code-window-bar">
            <span>FirstSend.java</span>
            <span class="hero-version">v{{site.version}}</span>
          </div>
          <pre><code class="language-java">Email email = EmailBuilder.startingBlank()
    .from("Sender", "sender@example.org")
    .withRecipients(new RecipientBuilder()
        .withAddress("recipient@example.net")
        .withType(TO)
        .build())
    .withSubject("It works")
    .withPlainText("Your first message.")
    .buildEmail();

mailer.sendMail(email);</code></pre>
          <div class="smtp-receipt">
            <span class="receipt-dot" aria-hidden="true"></span>
            <span>SMTP submission</span>
            <code>250 2.0.0 queued</code>
          </div>
        </div>
      </div>
