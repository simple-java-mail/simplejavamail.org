      <tr><td><code class="inline language-java">EmailBuilder.copying(Email)</code></td><td><code class="inline language-java">mail.emailBuilder().copying(email)</code></td></tr>
      <tr><td><code class="inline language-java">EmailBuilder.copying(EmailPopulatingBuilder)</code></td><td><code class="inline language-java">mail.emailBuilder().copying(builder)</code></td></tr>
      <tr><td><code class="inline language-java">EmailBuilder.copying(MimeMessage)</code></td><td><code class="inline language-java">mail.emailBuilder().copying(message)</code></td></tr>
      <tr><td><code class="inline language-java">EmailBuilder.replyingTo(Email)</code></td><td><code class="inline language-java">mail.emailBuilder().replyingTo(email)</code></td></tr>
      <tr><td><code class="inline language-java">EmailBuilder.replyingTo(Email, String)</code></td><td><code class="inline language-java">mail.emailBuilder().replyingTo(email, template)</code></td></tr>
      <tr><td><code class="inline language-java">EmailBuilder.replyingTo(MimeMessage)</code></td><td><code class="inline language-java">mail.emailBuilder().replyingTo(message)</code></td></tr>
