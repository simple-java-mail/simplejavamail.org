      <tr><td><code class="inline language-java">EmailBuilder.replyingToAll(MimeMessage)</code></td><td><code class="inline language-java">mail.emailBuilder().replyingToAll(message)</code></td></tr>
      <tr><td><code class="inline language-java">EmailBuilder.replyingToAll(MimeMessage, String)</code></td><td><code class="inline language-java">mail.emailBuilder().replyingToAll(message, template)</code></td></tr>
