---
layout: "layouts/docs-landing.hbs"
permalink: "/docs.html"
tags: ["publicPage"]
title: "Documentation"
style: "home"
description: "Search the Simple Java Mail guides, send your first email, or find the instructions for the capability you need."
---
<section class="docs-discovery-intro">
  <h1>Documentation</h1>
  <div class="docs-index-search">
    <label for="docs-search-label">Search the documentation</label>
    <span id="docs-search-label" class="visually-hidden">Search the Simple Java Mail documentation</span>
    <pagefind-searchbox placeholder="Try ‘DKIM’, ‘failover’, or ‘sending limits’" show-sub-results></pagefind-searchbox>
  </div>
  <nav class="docs-entry-links" aria-label="Documentation entry points">
    <a href="/download.html#first-email">Send your first email</a>
    <a href="/features.html">Explore capabilities</a>
    <a href="/migration-notes-10.0.0.html">Migrate to 10.0.0</a>
  </nav>
</section>
<div class="guide-directory">
{{#each (documentationGroups nav @root.capabilities)}}
  <section id="{{anchor}}" aria-labelledby="directory-{{anchor}}">
    <h2 id="directory-{{anchor}}">{{label}}</h2>
    <ul>
      {{#each items}}
        <li><a href="{{this.url}}">{{title}}</a><p>{{description}}</p>
          {{#if children}}<ul>{{#each children}}<li><a href="{{this.url}}">{{title}}</a><p>{{description}}</p></li>{{/each}}</ul>{{/if}}
        </li>
      {{/each}}
    </ul>
  </section>
{{/each}}
</div>
