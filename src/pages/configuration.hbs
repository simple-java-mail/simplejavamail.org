  <a href="#section-programmatic-api-common" id="section-programmatic-api-common" class="section-link h2">&sect;</a>
  <h2>Programmatic API - common settings</h2>

  <section>
    <div>
      <p>
        Start with one <code class="inline language-java">SimpleJavaMail</code> instance. Ask it for a fresh builder whenever you start an independent
        email or Mailer construction flow. The public builder interfaces contain the complete option reference.
      </p>
    </div>

    <div>
<pre><code class="small">SimpleJavaMail mail = SimpleJavaMail.fromDefaults();

// start with a fresh builder
MailerRegularBuilder&lt;?&gt; mailerBuilder = mail.mailerBuilder()
  .withSMTPServer("smtp.host.com", 25, "username", "password");
// or
mailerBuilder = mail.mailerBuilder()
  .withSMTPServerHost("smtp.host.com")
  .withSMTPServerPort(25)
  .withSMTPServerUsername("username")
  .withSMTPServerPassword("password");
</code></pre>
      <pre><code class="small">
// you can even leave out some details for an anonymous SMTP server
mail.mailerBuilder().withSMTPServer("smtp.host.com", 25);
// or
mail.mailerBuilder()
  .withSMTPServerHost("smtp.host.com")
  .withSMTPServerPort(25);

// adding the transport strategy...
mailerBuilder.withTransportStrategy(TransportStrategy.SMTP_TLS)

// narrow escape hatch for broken STARTTLS servers; plain SMTP only
mailerBuilder.withOpportunisticTLS(false)

// or instead adding anonymous proxy configuration
mailerBuilder.withProxy("proxy.host.com", 1080);
// or
mailerBuilder
  .withProxyHost("proxy.host.com")
  .withProxyPort(1080);

// or authenticated proxy
mailerBuilder
  .withProxy("proxy.host.com", 1080, "proxy username", "proxy password");
// or
mailerBuilder
  .withProxyHost("proxy.host.com")
  .withProxyPort(1080)
  .withProxyUsername("proxy username")
  .withProxyPassword("proxy password");
</code></pre>
      <pre><code class="small">
// anonymous smtp + anonymous proxy + default SMTP protocol strategy
mailerBuilder
        .withSMTPServerHost("smtp.host.com").withSMTPServerPort(25)
        .withProxyHost("proxy.host.com").withProxyPort(1080);
</code></pre>
      <pre><code class="small">
// configure everything!
mail.mailerBuilder()
        .withSMTPServer("smtp.host.com", 587, "user@host.com", "password")
        .withTransportStrategy(TransportStrategy.SMTP_TLS)
        .withProxy("socksproxy.host.com", 1080, "proxy user", "proxy password")
        .buildMailer()
        .sendMail(email);
</code></pre>
      <pre><code class="small">
// preconfigured Session?
mail.mailerBuilder(session);

// preconfigured but you need anonymous proxy?
mail.mailerBuilder(session)
        .withProxy("socksproxy.host.com", 1080);

// preconfigured but you need authenticated proxy?
mail.mailerBuilder(session)
        .withProxy("socksproxy.host.com", 1080, "proxy user", "proxy password");
</code></pre>
    </div>
  </section>


  <a href="#section-programmatic-api-other" id="section-programmatic-api-other" class="section-link h3">&sect;</a>
  <h3>Programmatic API - other settings</h3>

  <section>
    <div class="view">
      <p>
        The mailer builder also covers validation, diagnostics, timeouts, local binding, shared signing defaults, and
        <a href="features.html#section-extension-points">extension points</a>.
      </p>
    </div>

    <div class="wide full-width-example">
      <pre><code class="small">// report missing fields, invalid addresses and CRLF suspicions as warnings,
// then continue with SMTP handling
mailerBuilder.disablingAllClientValidation(true);
</code></pre>
		<pre><code class="small">// make the underlying Jakarta Mail Session produce debug output
mailerBuilder
    .withDebugLogging(true)
    .withDebugOutput(SessionDebugOutput.SLF4J); // STDOUT, STDERR or SLF4J
</code></pre>
      <pre><code class="small">// skip actually sending email, just log it
mailerBuilder.withTransportModeLoggingOnly(true);
</code></pre>
      <pre><code class="small">// custom SSL connection factory (note: breaks setups with authenticated proxy!)
mailerBuilder.withCustomSSLFactoryClass("org.mypackage.MySSLFactory");
mailerBuilder.withCustomSSLFactoryInstance(mySSLFactoryInstance);
</code></pre>
      <pre><code class="small">
// change email validation strategy
mailerBuilder.withEmailValidator(
	JMail.strictValidator()
		.requireOnlyTopLevelDomains(TopLevelDomain.DOT_COM)
		.withRule(email -> email.localPart().startsWith("allowed"))
)

// restore the default strict JMail address validator:
mailerBuilder.resetEmailValidator();
// clear the JMail address policy; keep completeness, encoded-word and CRLF checks:
mailerBuilder.clearEmailValidator();
</code></pre>
<pre><code class="small">
// set custom properties
mailerBuilder.withProperties(new Properties());
mailerBuilder.withProperties(new HashMap());
mailerBuilder.withProperty("mail.smtp.sendpartial", true);

// or directly modify the internal Session instance:
mailer.getSession().getProperties().setProperty("mail.smtp.sendpartial", true);
</code></pre>
<pre><code class="small">
/* Secure TLS defaults since 9.2.0. These calls are optional. */
mailerBuilder.trustingAllHosts(false);
mailerBuilder.verifyingServerIdentity(true);

// preferred for private PKI: add the issuing CA to the JVM trust store
// narrow compatibility exception if that is not possible:
mailerBuilder.trustingSSLHosts("smtp.internal.example");
// broad compatibility escape hatch; avoid in production:
mailerBuilder.trustingAllHosts(true);

// clear or reset trust exceptions
mailerBuilder.clearTrustedSSLHosts();
mailerBuilder.resetTrustingAllHosts();
</code></pre>
<pre><code class="small">
// compatibility escape hatch; disables hostname verification
mailerBuilder.verifyingServerIdentity(false);
// restore the secure default
mailerBuilder.resetVerifyingServerIdentity();
</code></pre>
<pre><code class="small">// pooled-delivery executor defaults
mailerBuilder.withThreadPoolSize(3);
// 0: core threads stay alive, !0: threads die after delay (default 1)
mailerBuilder.withThreadPoolKeepAliveTime(5000);

// optional bound on waiting async tasks, separate from worker count
mailerBuilder.withAsyncQueueCapacity(100);
mailerBuilder.withAsyncQueueOverflowPolicy(AsyncQueueOverflowPolicy.REJECT);

// completely replace the thread pool executor with your own
// discard built-in queue settings; configure your executor's queue yourself
mailerBuilder.resetAsyncQueue()
    .withExecutorService(new MyAwesomeCustomThreadPoolExecutor());
</code></pre>
		  <pre><code class="small">// change the SMTP session timeout (affects socket connect-, read- and write timeouts)
mailerBuilder.withSessionTimeout(10 * 1000); // 10 seconds for quick disconnect
</code></pre>
		  <pre><code class="small">// bind the outgoing SMTP socket to a local/source address
// the local port is advanced and usually should be omitted
mailerBuilder.withLocalBindAddress("203.0.113.10");
mailerBuilder.withLocalBindAddress("203.0.113.10", 25252);
</code></pre>
		  <pre><code class="small">// identify the SMTP client hostname sent in EHLO/HELO
// useful for corporate relay policy, logging, tracing and diagnostics
mailerBuilder.withSmtpClientHostname("orders-service.prod.example.com");
mailerBuilder.clearSmtpClientHostname();
</code></pre>
		  <pre><code class="small">// configure DKIM once for all emails sent through this mailer
// individual emails can still provide their own DKIM config
mailerBuilder.withDefaultDkimSigning(defaultDkimConfig);
</code></pre>
		  <pre><code class="small">// change the default sending logic to your own approach
mailerBuilder.withCustomMailer(yourOwnCustomMailerImpl); // send emails, test connections
</code></pre>
    </div>
  </section>


  <a href="#section-proxy-bridge-ports" id="section-proxy-bridge-ports" class="section-link h3">&sect;</a>
  {{#> components/feature-heading-h3 socks=true}}Authenticated proxy bridge ports{{/components/feature-heading-h3}}

  <section>
    <div class="view">
      <p>
        Jakarta Mail cannot authenticate to a SOCKS proxy by itself. For authenticated proxies, Simple Java Mail starts a small local bridge that
        handles the proxy login and relays the connection. The bridge listens only on the JVM's loopback address and stops when its Mailer has no
        active proxy operations.
      </p>
      <p>
        Concurrent work through one Mailer shares that Mailer's bridge. By default the bridge asks the operating system for an available loopback port
        every time it starts. Separate authenticated-proxy Mailers can therefore run at the same time without coordinating ports. Anonymous SOCKS
        proxies do not use a bridge.
      </p>
      <p>
        Simple Java Mail writes the selected port to the effective Session before opening the SMTP connection. The value is available as
        <code class="inline language-properties">mail.smtp.socks.port</code> or <code class="inline language-properties">mail.smtps.socks.port</code>
        and can change when a stopped bridge starts again. Use <code class="inline language-java">withProxyBridgePort(...)</code>, or the
        <code class="inline language-properties">simplejavamail.proxy.socks5bridge.port</code> property, only when you need a fixed positive port.
      </p>
    </div>

    <div class="wide full-width-example">
<pre><code class="language-java small">SimpleJavaMail mail = SimpleJavaMail.fromDefaults();

Mailer mailer = mail.mailerBuilder()
    .withSMTPServer("smtp.example.com", 587, "smtp-user", "smtp-password")
    .withTransportStrategy(TransportStrategy.SMTP_TLS)
    .withProxy("proxy.example.com", 1080, "proxy-user", "proxy-password")
    .buildMailer();

// Only if the local bridge must use a fixed port:
Mailer fixedPortMailer = mail.mailerBuilder()
    .withSMTPServer("smtp.example.com", 587, "smtp-user", "smtp-password")
    .withTransportStrategy(TransportStrategy.SMTP_TLS)
    .withProxy("proxy.example.com", 1080, "proxy-user", "proxy-password")
    .withProxyBridgePort(1081)
    .buildMailer();
</code></pre>
    </div>
  </section>


  <a href="#section-config-properties" id="section-config-properties" class="section-link h2">&sect;</a>
  <h2>Properties files</h2>

  <section>
    <div class="view">
      <p>
        Use <code class="inline language-java">SimpleJavaMail.fromDefaults()</code> when you want the conventional setup. On its first call, it reads an
        optional <code class="inline language-properties">simplejavamail.properties</code> resource from the classpath, then environment variables, then
        JVM system properties. It keeps that immutable snapshot for later calls and never consults Spring.
      </p>
      <p>
        For explicit application-owned configuration, add sources to a new <code class="inline language-java">ConfigLoader</code> from lowest to highest
        priority and call <code class="inline language-java">load()</code>. A later non-blank value wins. A blank value is treated as absent, so it does
        not hide a useful value from an earlier source.
      </p>
      <p>
        Only the winning value is parsed. A malformed lower-priority value therefore causes no error when a valid higher-priority source replaces it:
      </p>
<pre><code class="language-text small">Lower priority: simplejavamail.properties
simplejavamail.smtp.port=not-a-number
                    ↓ overridden before parsing
Higher priority: environment variable
SIMPLEJAVAMAIL_SMTP_PORT=587
                    ↓ parsed
Loaded SMTP port: 587</code></pre>
      <p>
        The conventional short form is equivalent to:
      </p>
<pre><code class="language-java small">SimpleJavaMailConfig config = ConfigLoader.builder()
    .withClasspathResource("simplejavamail.properties")
    .withEnvironmentVariables()
    .withSystemProperties()
    .load();

SimpleJavaMail mail = SimpleJavaMail.withConfig(config);</code></pre>
      <p>
        Only add environment and system-property sources when you want them. Explicit loaders do not silently read either one. Calls made directly on a
        Mailer or email builder override the snapshot values copied into that builder.
      </p>
    </div>

    <div class="side">
      Compose the sources your application owns:
<pre><code class="language-java small">SimpleJavaMailConfig config = ConfigLoader.builder()
    .withClasspathResource("mail-base.properties")
    .withPropertiesFile(
        "deployment file",
        Path.of("config", "simplejavamail.properties"))
    .withProperties("runtime overrides", runtimeOverrides)
    .withMap("local overrides", localOverrides)
    .withSource(secretManagerSource)
    .load();

SimpleJavaMail mail = SimpleJavaMail.withConfig(config);</code></pre>
      <p>
        A <code class="inline language-java">withPropertiesFile(Path)</code> source is sampled whenever <code class="inline language-java">load()</code>
        runs, and Simple Java Mail closes the stream it opens. <code class="inline language-java">withInputStream(...)</code> still consumes and closes the
        supplied stream immediately. Maps, <code class="inline language-java">Properties</code>, and custom sources are sampled at load time. The snapshot
        detaches their values before returning.
      </p>
    </div>
  </section>

  <section>
    <div class="view">
      <p>
        A custom <code class="inline language-java">ConfigSource</code> returns a stable diagnostic name and a map keyed by the canonical
        <code class="inline language-properties">simplejavamail.*</code> names. Strict sources reject unknown keys. Process environment and system
        sources are deliberately non-strict because most of their entries belong to other software.
      </p>
      <p>
        Secret lookup, decryption, and refresh policy belong in your application or configuration framework. Return the already decrypted values from
        the source. Simple Java Mail validates and copies them, but does not add a secret-encryption format of its own.
      </p>
    </div>
    <div class="side">
<pre><code class="language-java small">ConfigSource secretManagerSource = new ConfigSource() {
    public String getName() {
        return "application secret manager";
    }

    public Map&lt;String, ?&gt; getProperties() {
        return secretManager.readMailSettings();
    }
};</code></pre>
      <p>
        Validation errors name the source and property key without printing the configured value. A snapshot's
        <code class="inline language-java">toString()</code> redacts passwords, key material, and arbitrary Session properties.
      </p>
    </div>
  </section>

  <a href="#section-config-snapshot" id="section-config-snapshot" class="section-link h3">&sect;</a>
  <h3>When changes take effect</h3>

  <section>
    <div class="view">
      <p>
        A <code class="inline language-java">SimpleJavaMailConfig</code> is a detached, thread-safe snapshot. Changing a source after
        <code class="inline language-java">load()</code>, or loading another snapshot, does not reconfigure an existing factory, builder,
        <code class="inline language-java">Email</code>, <code class="inline language-java">Mailer</code>, or mail session.
      </p>
      <p>
        To change configuration, build a new snapshot and factory, then request fresh builders from it. You can use a prior snapshot as the first source
        with <code class="inline language-java">withConfig(previous)</code> when the replacement should override only part of it.
      </p>
      <p>
        Inspect resolved values with <code class="inline language-java">hasProperty(...)</code>, the typed getters, and
        <code class="inline language-java">getPropertySource(...)</code>. <code class="inline language-java">asMap()</code> and the wildcard maps it
        contains are unmodifiable.
      </p>
      <p>
        Static inbound methods on <code class="inline language-java">EmailConverter</code> use the conventional default snapshot. Use
        <code class="inline language-java">mail.converter()</code> when parsing should produce builders backed by an explicit factory snapshot.
      </p>
      <p>
        When replacing a <code class="inline language-java">Mailer</code>, let any work already using the old instance finish and then
        <a href="/sending-and-execution.html#section-mailer-lifecycle">close it</a>.
      </p>
    </div>

    <div class="side">
<pre><code class="language-java">SimpleJavaMailConfig productionConfig = ConfigLoader.builder()
    .withProperties("production", productionProperties)
    .load();
SimpleJavaMail productionMail = SimpleJavaMail.withConfig(productionConfig);
Mailer productionMailer = productionMail.mailerBuilder().buildMailer();

SimpleJavaMailConfig failoverConfig = ConfigLoader.builder()
    .withProperties("failover", failoverProperties)
    .load();
SimpleJavaMail failoverMail = SimpleJavaMail.withConfig(failoverConfig);
Mailer failoverMailer = failoverMail.mailerBuilder().buildMailer();

// Existing objects still use productionConfig.
// Send new work through failoverMailer, let old work finish, then:
productionMailer.close();
</code></pre>
    </div>
  </section>

  <a href="#section-environment-variables" id="section-environment-variables" class="section-link h3">&sect;</a>
  <h3>Environment variable names</h3>

  <section>
    <div class="view">
      <p>
        For the fixed properties listed below, uppercase the property name and replace each dot with an underscore. There is no additional relaxed
        binding: the name comes directly from the documented property key.
      </p>
      <p>
        The two wildcard namespaces are different: <code class="inline language-properties">simplejavamail.extraproperties.*</code> and
        <code class="inline language-properties">simplejavamail.defaults.connectionpool.clusters.*</code> are scanned as literal names. An environment
        variable such as <code class="inline language-text">SIMPLEJAVAMAIL_EXTRAPROPERTIES_MAIL_SMTP_TIMEOUT</code> is therefore not recognized.
      </p>
      <p>
        Some process launchers can supply literal lowercase names containing dots, but support varies between shells, containers, and operating systems.
        For wildcard settings, prefer a property file, an exact dotted JVM <code class="inline language-text">-D</code> system property, or the Java API.
      </p>
    </div>

    <div class="side">
<pre><code class="language-properties">SIMPLEJAVAMAIL_SMTP_HOST=smtp.example.com
SIMPLEJAVAMAIL_SMTP_PORT=587
SIMPLEJAVAMAIL_TRANSPORTSTRATEGY=SMTP_TLS
SIMPLEJAVAMAIL_DEFAULTS_FROM_ADDRESS=sender@example.com
</code></pre>
    </div>
  </section>

  <a href="#section-available-properties" id="section-available-properties" class="section-link h3">&sect;</a>
  <h3>Available properties</h3>

  <section>
    <div class="view">
      <p>
        Most mailer settings have a property equivalent, so each environment can use different values without changing application code.
      </p>
	  <p>
		<code class="inline language-properties">simplejavamail.opportunistic.tls</code> only affects the optional STARTTLS upgrade used by plain
		<code class="inline language-text">SMTP</code>. It does not weaken <code class="inline language-text">SMTP_TLS</code>, OAuth2 transport, or
		<code class="inline language-text">SMTPS</code>. An explicit <code class="inline language-java">withOpportunisticTLS(...)</code> call wins over the property.
	  </p>
	  <p>
		For <code class="inline language-properties">simplejavamail.dkim.signing.private_key_file_or_data</code>, prefix a path with
		<code class="inline language-properties">file:</code> or inline Base64-encoded key bytes with
		<code class="inline language-properties">base64:</code>. Unprefixed values retain their legacy path-or-UTF-8-data behavior.
	  </p>
	  <p>
		The embedded-image flags describe their exact route: <code class="inline language-properties">outside.base.url</code> controls URL resolution and
		<code class="inline language-properties">outside.base.classpath</code> controls classpath resolution.
	  </p>
    </div>

    <div class="side">
<pre><code class="language-properties"># Debugging and transport
simplejavamail.javaxmail.debug=true
simplejavamail.javaxmail.debug.out=SLF4J
simplejavamail.transportstrategy=SMTP_TLS
simplejavamail.transport.mode.logging.only=false
simplejavamail.opportunistic.tls=false

# SMTP destination, protocol identity and local/source binding
simplejavamail.smtp.host=smtp.default.com
simplejavamail.smtp.port=587
simplejavamail.smtp.username=username
simplejavamail.smtp.password=password
simplejavamail.smtp.clienthostname=orders-service.prod.example.com
simplejavamail.smtp.localaddress=203.0.113.10
simplejavamail.smtp.localport=25252

# Validation, SSL and proxying
simplejavamail.disable.all.clientvalidation=false
simplejavamail.custom.sslfactory.class=org.mypackage.ssl.MySSLSocketFactoryClass
simplejavamail.proxy.host=proxy.default.com
simplejavamail.proxy.port=1080
simplejavamail.proxy.username=username proxy
simplejavamail.proxy.password=password proxy
# 0 lets the operating system select an available loopback bridge port
simplejavamail.proxy.socks5bridge.port=0
simplejavamail.defaults.sessiontimeoutmillis=60000
# Optional total send budget (ISO-8601); omitted means disabled
simplejavamail.defaults.mailsend.timeout=PT30S
simplejavamail.defaults.trustallhosts=false
simplejavamail.defaults.trustedhosts=192.168.1.122;mymailserver.com;ix55432y
simplejavamail.defaults.verifyserveridentity=true

# Email defaults
simplejavamail.defaults.subject=Sweet News
simplejavamail.defaults.from.name=From Default
simplejavamail.defaults.from.address=from@default.com
simplejavamail.defaults.replyto.name=Reply-To Default
simplejavamail.defaults.replyto.address=reply-to@default.com
simplejavamail.defaults.bounceto.name=Bounce-To Default
simplejavamail.defaults.bounceto.address=bounce-to@default.com
simplejavamail.defaults.to.name=To Default
simplejavamail.defaults.to.address=to@default.com
simplejavamail.defaults.cc.name=CC Default
simplejavamail.defaults.cc.address=cc@default.com
simplejavamail.defaults.bcc.name=
simplejavamail.defaults.bcc.address=bcc1@default.com;bcc2@default.com

# Delivery Status Notification defaults
simplejavamail.defaults.delivery.status.notification.notify=FAILURE,DELAY
simplejavamail.defaults.delivery.status.notification.return.option=HEADERS_ONLY

# Content-Transfer-Encoding defaults
simplejavamail.defaults.content.transfer.encoding=QUOTED_PRINTABLE
simplejavamail.defaults.body.text.content.transfer.encoding=BIT7
simplejavamail.defaults.body.html.content.transfer.encoding=BASE_64
simplejavamail.defaults.body.calendar.content.transfer.encoding=QUOTED_PRINTABLE

# Pooled-delivery executor defaults
simplejavamail.defaults.poolsize=10
simplejavamail.defaults.poolsize.keepalivetime=2000

# Optional async queue controls (default capacity is -1, meaning unbounded)
simplejavamail.defaults.async.queue.capacity=100
simplejavamail.defaults.async.queue.overflowpolicy=REJECT
# Positive caller-side admission wait; used only by WAIT_FOR_CAPACITY
simplejavamail.defaults.async.queue.waittimeoutmillis=1000

# Connection-pool defaults
simplejavamail.defaults.connectionpool.clusterkey.uuid=38400000-8cf0-11bd-b23e-10b96e4ef00d
simplejavamail.defaults.connectionpool.coresize=0
simplejavamail.defaults.connectionpool.maxsize=4
simplejavamail.defaults.connectionpool.claimtimeout.millis=10000
simplejavamail.defaults.connectionpool.expireafter.millis=5000
simplejavamail.defaults.connectionpool.loadbalancing.strategy=ROUND_ROBIN

# Per-cluster defaults
simplejavamail.defaults.connectionpool.clusters.orders.clusterkey.uuid=00000000-0000-0000-0000-000000000301
simplejavamail.defaults.connectionpool.clusters.orders.coresize=0
simplejavamail.defaults.connectionpool.clusters.orders.maxsize=3
simplejavamail.defaults.connectionpool.clusters.orders.claimtimeout.millis=30000
simplejavamail.defaults.connectionpool.clusters.orders.expireafter.millis=600000
simplejavamail.defaults.connectionpool.clusters.orders.loadbalancing.strategy=RANDOM_ACCESS
simplejavamail.defaults.connectionpool.clusters.00000000-0000-0000-0000-000000000302.maxsize=8

# S/MIME defaults
simplejavamail.smime.signing.keystore=my_keystore.pkcs12
simplejavamail.smime.signing.keystore_password=keystore_password
simplejavamail.smime.signing.key_alias=key_alias
simplejavamail.smime.signing.key_password=key_password
simplejavamail.smime.signing.algorithm=SHA3-256withECDSA
simplejavamail.smime.encryption.certificate=x509inStandardPEM.crt
simplejavamail.smime.encryption.key_encapsulation_algorithm=RSA_OAEP_SHA384
# AES is recommended; DES_EDE3_CBC remains available for legacy recipient compatibility.
simplejavamail.smime.encryption.cipher=AES256_CBC

# DKIM defaults
simplejavamail.dkim.signing.private_key_file_or_data=file:my_dkim_key.der
simplejavamail.dkim.signing.selector=dkim1
simplejavamail.dkim.signing.signing_domain=your-domain.com
simplejavamail.dkim.signing.use_length_param=false
# Omit header exclusions to keep the default signing list, including From.
simplejavamail.dkim.signing.header_canonicalization=RELAXED
simplejavamail.dkim.signing.body_canonicalization=RELAXED
simplejavamail.dkim.signing.algorithm=SHA256_WITH_RSA

# Embedded image dynamic resolution
simplejavamail.embeddedimages.dynamicresolution.enable.dir=true
simplejavamail.embeddedimages.dynamicresolution.enable.url=false
simplejavamail.embeddedimages.dynamicresolution.enable.classpath=true
simplejavamail.embeddedimages.dynamicresolution.base.dir=/var/opt/static
simplejavamail.embeddedimages.dynamicresolution.base.url=
simplejavamail.embeddedimages.dynamicresolution.base.classpath=/static
simplejavamail.embeddedimages.dynamicresolution.outside.base.dir=true
simplejavamail.embeddedimages.dynamicresolution.outside.base.classpath=false
simplejavamail.embeddedimages.dynamicresolution.outside.base.url=false
simplejavamail.embeddedimages.dynamicresolution.mustbesuccesful=true
</code></pre>
    </div>
  </section>

	<section>
		<div class="wide">
			<p>
				Spring applications use these same property names. The <a href="/spring.html#section-spring-profiles">Spring integration guide</a> explains
				profile handling, dynamic keys, and the configuration metadata available to compatible IDEs.
			</p>
		</div>
	</section>

	<section>
		<div class="view">
			<p>
				Then there are extra properties which will directly go on the internal Session object when
				building a Mailer instance.
			</p>
			<p>
				They use the same precedence as the other settings: system properties win over environment variables, and environment variables win over
				property-file values.
			</p>
		</div>

		<div class="side">
<pre><code class="language-properties">simplejavamail.extraproperties.my.extra.property=value
simplejavamail.extraproperties.mail.smtp.ssl.socketFactory.class=org.mypackage.MySSLSocketFactory
simplejavamail.extraproperties.mail.smtp.timeout=30000
</code></pre>
		</div>
	</section>


	<a href="#section-config-mailer" id="section-config-mailer" class="section-link h2">&sect;</a>
	<h2>Mailer level email defaults and overrides</h2>

	<section>
		<p class="wide">
			With property files and system properties you can define global defaults. But sometimes that is not enough.
		</p>
		<p class="wide">
			With Simple Java Mail, you can set both defaults and overrides on the Mailer level using Java code. This will override
			global defaults loaded from a property file for example. However, before using it as defaults Email reference, you can still have your defaults
			initialized with global defaults, by using <code>emailBuilder.buildEmailCompletedWithDefaultsAndOverrides()</code>.
		</p>
		<p class="wide">
			<a href="features.html#section-exact-eml">Exact EML</a> is deliberately outside this message-governance layer. Its supplied bytes are already final,
			so Mailer defaults, overrides, configured content validation, and security transformations cannot change them. Put any required visible headers in the
			EML before building the exact Email, and configure only its SMTP envelope on the exact builder.
		</p>
		<div class="wide">
<pre><code class="language-java">SimpleJavaMail mail = SimpleJavaMail.fromDefaults();

Email yourServerLevelDefaults = mail.emailBuilder().startingBlank()
	/* set your defaults here */
	.buildEmailCompletedWithDefaultsAndOverrides(); // complete it from this factory's snapshot

Mailer adminServer = mail.mailerBuilder()
	// add SMTP settings
	.withEmailDefaults(yourServerLevelDefaults)
	.withEmailOverrides(yourServerLevelOverrides)
	.buildMailer();
</code></pre>
		</div>

		<p class="wide">
			One use case for this is when you have multiple mailer instances, each for a separate SMTP server clustered together (see
			<a href="/sending-and-execution.html#section-clustering">clustering</a>), you may want to define defaults or overrides for a specific server. You can do that by defining
			a reference Email instance and set it as <em>defaults</em> or <em>overrides</em> parameter.
		</p>
		<div class="wide">
			<pre><code class="language-java">// for example: force FROM to be always the same for the
// specific SMTP adminServer from the previous example:
Email yourServerLevelOverrides = mail.emailBuilder().startingBlank()
    .from("Admin", "admin@yourcompany.com")
    .buildEmail();
</code></pre>
		</div>
	</section>

	<section>
		<div class="view">
			<p>
				To keep defaults or overrides away from one email, configure that after whichever builder starter you used.
			</p>
		</div>

		<div class="side">
<pre><code class="language-java">Email email = mail.emailBuilder().startingBlank()
    .ignoringDefaults()
    .ignoringOverrides()
    // add the email content
    .buildEmail();
</code></pre>
		</div>
	</section>

	<section>
		<div class="view">
			<p>
				You can even exclude specific fields from the defaults or overrides if you want to make very specific exceptions.
			</p>
		</div>

		<div class="side">
<pre><code class="language-java">emailBuilder
	.dontApplyDefaultValueFor(EmailProperty.FROM_RECIPIENT, EmailProperty.REPLYTO_RECIPIENT)
	.dontApplyOverrideValueFor(EmailProperty.DKIM_SIGNING_CONFIG)
</code></pre>
		</div>
	</section>


  <a href="#section-combine-config" id="section-combine-config" class="section-link h2">&sect;</a>
  <h2>Combining everything for multiple environments</h2>

  <section>
    <div>
      <p>
        Let's set up configuration for a <strong>test</strong>, <strong>acceptance</strong> and <strong>production</strong> environment.
      </p>
      <h3>Properties for the environments</h3>
    </div>
    <div>
<pre><code class="language-properties small">#global default properties (simplejavamail.properties on classpath)

    # anonoymous SMTP inside 'safe' DMZ
    simplejavamail.smtp.host=dmz.smtp.candyshop.com
    simplejavamail.smtp.port=25

    # default sender and reply-to address
    simplejavamail.defaults.from.name=The Candy App
    simplejavamail.defaults.from.address=candyapp@candystore.com
    simplejavamail.defaults.replyto.name=Candystore Helpdesk
    simplejavamail.defaults.replyto.address=helpdesk@candystore.com
</code></pre>
<pre><code class="language-properties small">#overrides from TEST and UAT .../config/candystore/simplejavamail.properties

    # always send a copy to test archive
    simplejavamail.defaults.bcc.name=Archive TST UAT
    simplejavamail.defaults.bcc.address=test-archive@candyshop.com
</code></pre>
<pre><code class="language-properties small">#overrides from PRODUCTION .../config/candystore/simplejavamail.properties

    # always send a copy to production archive
    simplejavamail.defaults.bcc.name=Archive PRODUCTION
    simplejavamail.defaults.bcc.address=prod-archive@candyshop.com

    # smtp server in production is protected
    simplejavamail.smtp.username=creamcake
    simplejavamail.smtp.password=crusty_l0llyp0p

    # sending mails in production must go through proxy
    simplejavamail.proxy.host=proxy.candyshop.com
    simplejavamail.proxy.port=1080
    simplejavamail.proxy.username=candyman
    simplejavamail.proxy.password=I has the sugarcanes!!1!
</code></pre>
    </div>

    <h3>Now for the programmatic part</h3>

    <div>
      <p>
        Build the complete source list for the selected environment, then load one snapshot and create the factory that owns it. The order below goes
        from broad defaults to the most deployment-specific overrides.
      </p>
<pre><code class="language-java">ConfigLoader loader = ConfigLoader.builder()
    .withClasspathResource("simplejavamail.properties")
    .withPropertiesFile(
        "selected environment",
        Path.of("config", "candystore", "simplejavamail.properties"));

if (someSpecialCondition) {
    loader.withClasspathResource("special-override.properties");
}

Properties runtimeOverrides = new Properties();
runtimeOverrides.setProperty("simplejavamail.smtp.port", "2525");
SimpleJavaMailConfig config = loader
    .withProperties("runtime overrides", runtimeOverrides)
    .withEnvironmentVariables()
    .withSystemProperties()
    .load();

SimpleJavaMail mail = SimpleJavaMail.withConfig(config);
Mailer mailer = mail.mailerBuilder()
    // Direct builder values win over the snapshot.
    .withSMTPServerPort(587)
    .withTransportStrategy(TransportStrategy.SMTP_TLS)
    .buildMailer();
</code></pre>
    </div>
  </section>


